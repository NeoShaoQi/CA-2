<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gym Workout Tracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card shadow-lg p-5">

        <div class="text-center">

            <h1 class="text-primary">
                🏋️ Gym Workout Tracker
            </h1>

            <p class="lead">
                Manage your workouts, calories and BMI
            </p>

            <hr>

        </div>

        <div class="row g-3">

            <!-- Workout -->
            <div class="col-md-6">
                <a href="/workouts" class="btn btn-primary w-100 p-3">
                    📋 View Workouts
                </a>
            </div>

            <!-- Add Workout -->
            <div class="col-md-6">
                <a href="/addWorkout" class="btn btn-success w-100 p-3">
                    ➕ Add Workout
                </a>
            </div>

            <!-- Calories -->
            <div class="col-md-6">
                <a href="/calories" class="btn btn-warning w-100 p-3">
                    🍎 View Calories
                </a>
            </div>

            <!-- Add Calories -->
            <div class="col-md-6">
                <a href="/addCalories" class="btn btn-info w-100 p-3">
                    ➕ Add Food
                </a>
            </div>

            <!-- BMI -->
            <div class="col-md-12">
                <a href="/bmi" class="btn btn-secondary w-100 p-3">
                    ⚖️ BMI Calculator
                </a>
            </div>

        </div>

    </div>

</div>

</body>
</html>
