<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Gym Workout & Fitness Tracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<div class="container py-5">

    <div class="card shadow-lg">

        <div class="card-body p-5">

            <% if (currentUser) { %>

                <div class="text-center mb-5">

                    <h1 class="display-5 fw-bold text-primary">
                        🏋️ Gym Workout & Fitness Tracker
                    </h1>

                    <p class="lead">
                        Welcome back,
                        <strong><%= currentUser.username %></strong>
                    </p>

                    <span class="badge bg-dark fs-6">
                        <%= currentUser.role.toUpperCase() %>
                    </span>

                </div>

                <div class="row g-4">

                    <!-- Workouts -->
                    <div class="col-md-6">

                        <div class="card border-primary shadow-sm h-100">

                            <div class="card-body text-center">

                                <h3>🏋️ Workouts</h3>

                                <p>
                                    Browse available workouts.
                                </p>

                                <a href="/workouts"
                                   class="btn btn-primary">
                                    View Workouts
                                </a>

                            </div>

                        </div>

                    </div>

                    <!-- Calories -->
                    <div class="col-md-6">

                        <div class="card border-warning shadow-sm h-100">

                            <div class="card-body text-center">

                                <h3>🍎 Calories</h3>

                                <p>
                                    Browse available foods.
                                </p>

                                <a href="/calories"
                                   class="btn btn-warning">
                                    View Foods
                                </a>

                            </div>

                        </div>

                    </div>

                    <!-- BMI -->
                    <div class="col-md-6">

                        <div class="card border-info shadow-sm h-100">

                            <div class="card-body text-center">

                                <h3>⚖️ BMI Calculator</h3>

                                <p>
                                    Check your BMI instantly.
                                </p>

                                <a href="/bmi"
                                   class="btn btn-info">
                                    Calculate BMI
                                </a>

                            </div>

                        </div>

                    </div>

                    <% if (currentUser.role === 'admin') { %>

                    <!-- Admin -->
                    <div class="col-md-6">

                        <div class="card border-danger shadow-sm h-100">

                            <div class="card-body text-center">

                                <h3>🛠 Admin Panel</h3>

                                <p>
                                    Manage workouts, foods and users.
                                </p>

                                <a href="/admin"
                                   class="btn btn-danger">
                                    Open Dashboard
                                </a>

                            </div>

                        </div>

                    </div>

                    <% } %>

                </div>

                <hr class="my-5">

                <% if (currentUser.role === 'admin') { %>

                    <div class="text-center">

                        <a href="/addWorkout"
                           class="btn btn-success btn-lg me-2">
                            ➕ Add Workout
                        </a>

                        <a href="/addCalories"
                           class="btn btn-warning btn-lg">
                            ➕ Add Food
                        </a>

                    </div>

                <% } %>

                <div class="text-center mt-5">

                    <a href="/logout"
                       class="btn btn-outline-danger btn-lg">
                        Log Out
                    </a>

                </div>

            <% } else { %>

                <div class="text-center">

                    <h1 class="display-4 text-primary">
                        🏋️ Gym Workout & Fitness Tracker
                    </h1>

                    <p class="lead mt-3">
                        Track workouts, calories and monitor your health.
                    </p>

                    <div class="mt-5">

                        <a href="/login"
                           class="btn btn-primary btn-lg me-3">
                            Login
                        </a>

                        <a href="/register"
                           class="btn btn-success btn-lg">
                            Register
                        </a>

                    </div>

                </div>

            <% } %>

        </div>

    </div>

</div>

</body>

</html>
