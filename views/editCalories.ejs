<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Calorie Entry</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="text-warning mb-4">
            Edit Food Entry
        </h2>

        <!-- ==========================================================
             (ALTON) - Edit Calorie Entry
             Allows users to update an existing calorie record.
             ========================================================== -->

        <form action="/editCalories/<%= calorie.id %>" method="POST">

            <div class="mb-3">

                <label class="form-label">
                    Food Name
                </label>

                <input
                    type="text"
                    name="foodName"
                    class="form-control"
                    value="<%= calorie.foodName %>"
                    required>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Calories
                </label>

                <input
                    type="number"
                    name="calories"
                    class="form-control"
                    value="<%= calorie.calories %>"
                    required>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Meal Type
                </label>

                <select
                    name="mealType"
                    class="form-select"
                    required>

                    <option value="Breakfast"
                        <%= calorie.mealType === "Breakfast" ? "selected" : "" %>>
                        Breakfast
                    </option>

                    <option value="Lunch"
                        <%= calorie.mealType === "Lunch" ? "selected" : "" %>>
                        Lunch
                    </option>

                    <option value="Dinner"
                        <%= calorie.mealType === "Dinner" ? "selected" : "" %>>
                        Dinner
                    </option>

                    <option value="Snack"
                        <%= calorie.mealType === "Snack" ? "selected" : "" %>>
                        Snack
                    </option>

                </select>

            </div>

            <button
                type="submit"
                class="btn btn-warning">

                Update Entry

            </button>

            <a
                href="/calories"
                class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>

</body>

</html>