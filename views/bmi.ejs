<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BMI Calculator</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="/">
            🏋️ Gym Tracker
        </a>

        <div class="navbar-nav ms-auto">

            <a class="nav-link" href="/workouts">
                Workouts
            </a>

            <a class="nav-link" href="/calories">
                Calories
            </a>

            <% if (currentUser && currentUser.role === 'admin') { %>

                <a class="nav-link" href="/users">
                    Users
                </a>

                <a class="nav-link" href="/admin">
                    Admin
                </a>

            <% } %>

            <a class="nav-link" href="/logout">
                Logout
            </a>

        </div>

    </div>

</nav>

<div class="container mt-5">

    <div class="card shadow-lg">

        <div class="card-body">

            <h1 class="text-primary text-center mb-4">
                ⚖️ BMI Calculator
            </h1>

            <form action="/bmi" method="POST">

                <div class="mb-3">

                    <label class="form-label">
                        Weight (kg)
                    </label>

                    <input
                        type="number"
                        name="weight"
                        class="form-control"
                        step="0.1"
                        placeholder="Enter your weight"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Height (cm)
                    </label>

                    <input
                        type="number"
                        name="height"
                        class="form-control"
                        step="0.1"
                        placeholder="Enter your height"
                        required>

                </div>

                <div class="mt-4">

                    <button
                        type="submit"
                        class="btn btn-primary">

                        Calculate BMI

                    </button>

                    <a href="/"
                       class="btn btn-secondary">

                        ⬅ Back Home

                    </a>

                </div>

            </form>

            <% if (bmi) { %>

            <div class="card mt-5 border-success">

                <div class="card-body text-center">

                    <h3 class="text-success">
                        Your BMI Result
                    </h3>

                    <hr>

                    <h1 class="display-4">
                        <%= bmi %>
                    </h1>

                    <h4 class="mt-3">

                        <% if(category === "Underweight"){ %>

                            <span class="badge bg-warning text-dark">
                                <%= category %>
                            </span>

                        <% } else if(category === "Normal Weight"){ %>

                            <span class="badge bg-success">
                                <%= category %>
                            </span>

                        <% } else if(category === "Overweight"){ %>

                            <span class="badge bg-warning">
                                <%= category %>
                            </span>

                        <% } else { %>

                            <span class="badge bg-danger">
                                <%= category %>
                            </span>

                        <% } %>

                    </h4>

                </div>

            </div>

            <% } %>

            <div class="alert alert-secondary mt-4">

                <h5 class="mb-3">
                    BMI Categories
                </h5>

                <ul class="mb-0">

                    <li>
                        <strong>Below 18.5</strong> — Underweight
                    </li>

                    <li>
                        <strong>18.5 - 24.9</strong> — Normal Weight
                    </li>

                    <li>
                        <strong>25.0 - 29.9</strong> — Overweight
                    </li>

                    <li>
                        <strong>30.0 and above</strong> — Obese
                    </li>

                </ul>

            </div>

        </div>

    </div>

</div>

</body>

</html>
