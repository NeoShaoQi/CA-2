<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BMI Calculator</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container">

        <a class="navbar-brand" href="/">
            🏋️ Gym Tracker
        </a>

        <div class="navbar-nav ms-auto">

            <a class="nav-link" href="/workouts">
                Workouts
            </a>

            <a class="nav-link" href="/calories">
                Calories
            </a>

            <% if (currentUser && currentUser.role === 'admin') { %>

                <a class="nav-link" href="/users">
                    Users
                </a>

                <a class="nav-link" href="/admin">
                    Admin
                </a>

            <% } %>

            <a class="nav-link" href="/logout">
                Logout
            </a>

        </div>

    </div>

</nav>

<div class="container mt-5">

    <div class="card shadow-lg">

        <div class="card-body">

            <h1 class="text-primary text-center mb-4">
                ⚖️ BMI Calculator
            </h1>

            <form action="/bmi" method="POST">

                <div class="mb-3">

                    <label class="form-label">
                        Weight (kg)
                    </label>

                    <input
                        type="number"
                        name="weight"
                        class="form-control"
                        step="0.1"
                        placeholder="Enter your weight"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Height (cm)
                    </label>

                    <input
                        type="number"
                        name="height"
                        class="form-control"
                        step="0.1"
                        placeholder="Enter your height"
                        required>

                </div>

                <div class="mt-4">

                    <button
                        type="submit"
                        class="btn btn-primary">

                        Calculate BMI

                    </button>

                    <a href="/"
                       class="btn btn-secondary">

                        ⬅ Back Home

                    </a>

                </div>

            </form>


            <% if (bmi) { %>

<div class="card mt-5 border-success">

    <div class="card-body">

        <h3 class="text-success text-center mb-4">
            🏆 Your Fitness Summary
        </h3>

        <div class="row text-center">

            <div class="col-md-4">

                <h6 class="text-muted">
                    BMI
                </h6>

                <h1 class="display-5">
                    <%= bmi %>
                </h1>

            </div>

            <div class="col-md-4">

                <h6 class="text-muted">
                    Category
                </h6>

                <% if(category === "Underweight"){ %>

                    <span class="badge bg-warning text-dark fs-5">
                        <%= category %>
                    </span>

                <% } else if(category === "Normal Weight"){ %>

                    <span class="badge bg-success fs-5">
                        <%= category %>
                    </span>

                <% } else if(category === "Overweight"){ %>

                    <span class="badge bg-warning fs-5">
                        <%= category %>
                    </span>

                <% } else { %>

                    <span class="badge bg-danger fs-5">
                        <%= category %>
                    </span>

                <% } %>

            </div>

            <div class="col-md-4">

                <h6 class="text-muted">
                    Weekly Goal
                </h6>

                <h2 class="text-primary">
                    0.5 kg/week
                </h2>

            </div>

        </div>

        <hr>

        <div class="row text-center">

            <div class="col-md-4">

                <div class="card border-primary shadow-sm">

                    <div class="card-body">

                        <h6 class="text-muted">
                            🎯 Target Weight
                        </h6>

                        <h2>
                            <%= targetWeight %> kg
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card border-danger shadow-sm">

                    <div class="card-body">

                        <h6 class="text-muted">
                            📉 Weight To Lose
                        </h6>

                        <h2>
                            <%= weightToLose %> kg
                        </h2>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card border-success shadow-sm">

                    <div class="card-body">

                        <h6 class="text-muted">
                            🍎 Daily Calorie Goal
                        </h6>

                        <h2>
                            <%= dailyCalorieGoal %>
                        </h2>

                        <small>kcal/day</small>

                    </div>

                </div>

            </div>

        </div>

        <% if (weightToLose > 0) { %>

            <div class="alert alert-warning mt-4">

                <strong>Recommendation:</strong>

                You should aim to lose
                <strong><%= weightToLose %> kg</strong>

                at approximately

                <strong>0.5 kg per week</strong>.

            </div>

        <% } else { %>

            <div class="alert alert-success mt-4">

                🎉 Congratulations! Your current weight is already within the healthy BMI range.
                Focus on maintaining your fitness and eating a balanced diet.

            </div>

        <% } %>

    </div>

</div>

<% } %>

            <div class="alert alert-secondary mt-4">

                <h5 class="mb-3">
                    BMI Categories
                </h5>

                <ul class="mb-0">

                    <li>
                        <strong>Below 18.5</strong> — Underweight
                    </li>

                    <li>
                        <strong>18.5 - 24.9</strong> — Normal Weight
                    </li>

                    <li>
                        <strong>25.0 - 29.9</strong> — Overweight
                    </li>

                    <li>
                        <strong>30.0 and above</strong> — Obese
                    </li>

                </ul>

            </div>

        </div>

    </div>

</div>

</body>

</html>
