<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="display-5 fw-bold text-danger">
            🛠 Administrator Dashboard
        </h1>

        <p class="lead">
            Welcome back,
            <strong><%= currentUser.username %></strong>
        </p>

        <span class="badge bg-danger fs-6">
            ADMINISTRATOR
        </span>

    </div>

    <div class="row g-4">

        <!-- Users -->
        <div class="col-md-6">

            <div class="card shadow h-100 border-primary">

                <div class="card-body text-center">

                    <h2>👥</h2>

                    <h4>Users</h4>

                    <p>
                        View all registered users and their roles.
                    </p>

                    <a href="/users"
                       class="btn btn-primary">
                        View Users
                    </a>

                </div>

            </div>

        </div>

        <!-- Workouts -->
        <div class="col-md-6">

            <div class="card shadow h-100 border-success">

                <div class="card-body text-center">

                    <h2>🏋️</h2>

                    <h4>Workout Management</h4>

                    <p>
                        Add, edit and delete workouts.
                    </p>

                    <a href="/workouts"
                       class="btn btn-success">
                        Manage Workouts
                    </a>

                </div>

            </div>

        </div>

        <!-- Foods -->
        <div class="col-md-6">

            <div class="card shadow h-100 border-warning">

                <div class="card-body text-center">

                    <h2>🍎</h2>

                    <h4>Food Management</h4>

                    <p>
                        Add, edit and delete food items.
                    </p>

                    <a href="/calories"
                       class="btn btn-warning">
                        Manage Foods
                    </a>

                </div>

            </div>

        </div>

        <!-- BMI -->
        <div class="col-md-6">

            <div class="card shadow h-100 border-info">

                <div class="card-body text-center">

                    <h2>⚖️</h2>

                    <h4>BMI Calculator</h4>

                    <p>
                        Access the BMI calculator.
                    </p>

                    <a href="/bmi"
                       class="btn btn-info">
                        Open BMI Calculator
                    </a>

                </div>

            </div>

        </div>

    </div>

    <hr class="my-5">

    <div class="text-center">

        <a href="/"
           class="btn btn-secondary btn-lg me-3">
            🏠 Home
        </a>

        <a href="/logout"
           class="btn btn-danger btn-lg">
            🚪 Logout
        </a>

    </div>

</div>

</body>

</html>
