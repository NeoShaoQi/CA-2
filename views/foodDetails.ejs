<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Food Details</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<div class="container py-5">

    <div class="card shadow-lg">

        <div class="card-body">

            <h1 class="text-success text-center mb-4">

                🍎 Food Details

            </h1>

            <div class="text-center">

                <h2>

                    <%= food.foodName %>

                </h2>

                <hr>

                <h5>

                    Meal Type

                    <br>

                    <span class="badge bg-success">

                        <%= food.mealType %>

                    </span>

                </h5>

                <h5 class="mt-3">

                    Calories

                    <br>

                    <strong>

                        🔥 <%= food.calories %> kcal

                    </strong>

                </h5>

                <hr>

                <div class="row mt-4">

                    <div class="col-md-4">

                        <div class="card border-primary">

                            <div class="card-body">

                                <h6>

                                    Recommended Intake

                                </h6>

                                <h3>

                                    <%= recommended %>

                                </h3>

                                <small>kcal/day</small>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="card border-danger">

                            <div class="card-body">

                                <h6>

                                    Food Calories

                                </h6>

                                <h3>

                                    <%= food.calories %>

                                </h3>

                                <small>kcal</small>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="card border-success">

                            <div class="card-body">

                                <h6>

                                    Remaining Today

                                </h6>

                                <h3>

                                    <%= remaining %>

                                </h3>

                                <small>kcal</small>

                            </div>

                        </div>

                    </div>

                </div>

                <% if (remaining >= 0) { %>

                    <div class="alert alert-success mt-4">

                        ✔ You are still within the recommended daily calorie intake.

                    </div>

                <% } else { %>

                    <div class="alert alert-danger mt-4">

                        ⚠ This exceeds the recommended daily calorie intake.

                    </div>

                <% } %>

                <form action="/eatFood/<%= food.id %>" method="POST">

                    <button
                        type="submit"
                        class="btn btn-success mt-3">
                
                        🍽 Confirm Eat
                
                    </button>
                
                    <a href="/calories"
                       class="btn btn-secondary mt-3">
                
                        ⬅ Back to Food Library
                
                    </a>
                
                </form>

            </div>

        </div>

    </div>

</div>

</body>

</html>
