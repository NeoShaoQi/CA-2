<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Workout Library</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<div class="container py-5">

    <div class="card shadow-lg">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h1 class="text-primary mb-0">
                    🏋️ Workout Library
                </h1>

                <a href="/" class="btn btn-secondary">
                    ⬅ Back Home
                </a>

            </div>

            <!-- Search -->

            <form action="/workouts" method="GET" class="row g-3 mb-4">

                <div class="col-md-8">

                    <input
                        type="text"
                        name="search"
                        class="form-control"
                        placeholder="Search by workout name or type..."
                        value="<%= search || '' %>">

                </div>

                <div class="col-md-2">

                    <button
                        type="submit"
                        class="btn btn-primary w-100">

                        🔍 Search

                    </button>

                </div>

                <div class="col-md-2">

                    <a href="/workouts"
                       class="btn btn-outline-secondary w-100">

                        Clear

                    </a>

                </div>

            </form>

            <!-- Workout Table -->

            <table class="table table-hover table-bordered align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>ID</th>
                        <th>Workout</th>
                        <th>Type</th>
                        <th>Duration</th>
                        <th>Calories Burned</th>

                        <% if (currentUser.role === 'admin') { %>

                            <th width="220">
                                Actions
                            </th>

                        <% } else { %>

                            <th width="170">
                                Details
                            </th>

                        <% } %>

                    </tr>

                </thead>

                <tbody>

                <% if (workouts.length > 0) { %>

                    <% workouts.forEach(workout => { %>

                    <tr>

                        <td>
                            <%= workout.id %>
                        </td>

                        <td>

                            <strong>
                                <%= workout.workoutName %>
                            </strong>

                        </td>

                        <td>

                            <span class="badge bg-primary">
                                <%= workout.workoutType %>
                            </span>

                        </td>

                        <td>

                            <%= workout.duration %> mins

                        </td>

                        <td>

                            🔥 <%= workout.calories %> kcal

                        </td>

                        <% if (currentUser.role === 'admin') { %>

                        <td>

                            <a href="/editWorkout/<%= workout.id %>"
                               class="btn btn-warning btn-sm">

                                ✏ Edit

                            </a>

                            <a href="/deleteWorkout/<%= workout.id %>"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Delete this workout?')">

                                🗑 Delete

                            </a>

                        </td>

                        <% } else { %>

                        <td>

                            <a href="/workout/<%= workout.id %>"
                               class="btn btn-primary btn-sm">

                                👁 View Workout

                            </a>

                        </td>

                        <% } %>

                    </tr>

                    <% }) %>

                <% } else { %>

                    <tr>

                        <td colspan="6"
                            class="text-center">

                            No workouts found.

                        </td>

                    </tr>

                <% } %>

                </tbody>

            </table>

            <% if (currentUser.role === 'admin') { %>

            <div class="mt-4">

                <a href="/addWorkout"
                   class="btn btn-success">

                    ➕ Add Workout

                </a>

            </div>

            <% } %>

        </div>

    </div>

</div>

</body>

</html>
