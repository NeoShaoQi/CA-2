<!DOCTYPE html>
<html>
<head>
    <title>Workout List</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">    
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card shadow p-4">

        <h1 class="text-primary mb-4">
            Workout List
        </h1>
         <form action="/workouts" method="GET" class="row g-3 mb-4">

    <div class="col-md-6">
        <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search workout..."
            value="<%= search || '' %>">
    </div>

    <div class="col-md-2">
        <button
            type="submit"
            class="btn btn-primary w-100">
            Search
        </button>
    </div>

</form>


        <table class="table table-striped table-hover">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Workout Name</th>
                    <th>Type</th>
                    <th>Duration</th>
                </tr>
            </thead>

            <tbody>

                <% workouts.forEach(workout => { %>

                    <tr>

                        <td>
                            <%= workout.id %>
                        </td>

                        <td>
                            <%= workout.workoutName %>
                        </td>

                        <td>
                            <%= workout.workoutType %>
                        </td>

                        <td>
                            <%= workout.duration %> mins
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

        <div class="mt-3">

            <a href="/addWorkout" class="btn btn-success">
              Add Workout
            </a>

            /

        </div>

    </div>

</div>

</body>
</html>
