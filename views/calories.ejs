<!DOCTYPE html>
<html>
<head>
    <title>Calorie Tracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card shadow p-4">

        <h1 class="mb-4">Calorie Tracker</h1>

        <!-- Search -->
        <form action="/calories" method="GET" class="row g-3 mb-4">

            <div class="col-md-6">
                <input
                    type="text"
                    name="search"
                    class="form-control"
                    placeholder="Search food..."
                    value="<%= search || '' %>">
            </div>

            <div class="col-md-2">
                <button
                    type="submit"
                    class="btn btn-primary w-100">
                    🔍 Search
                </button>
            </div>

            <div class="col-md-2">
                <a href="/calories"
                   class="btn btn-secondary w-100">
                    Clear
                </a>
            </div>

        </form>

        <!-- Total Calories -->
        <div class="alert alert-info">
            Total Calories:
            <strong><%= totalCalories %></strong>
        </div>

        <!-- Food Table -->
        <table class="table table-striped table-hover">

            <thead class="table-dark">

                <tr>

                    <th>Food</th>
                    <th>Calories</th>
                    <th>Meal Type</th>

                    <% if (currentUser && currentUser.role === 'admin') { %>
                        <th>Actions</th>
                    <% } %>

                </tr>

            </thead>

            <tbody>

                <% calories.forEach(item => { %>

                    <tr>

                        <td><%= item.foodName %></td>

                        <td><%= item.calories %></td>

                        <td><%= item.mealType %></td>

                        <% if (currentUser && currentUser.role === 'admin') { %>

                        <td>

                            <a href="/editCalories/<%= item.id %>"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a href="/deleteCalories/<%= item.id %>"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Delete this food?')">
                                Delete
                            </a>

                        </td>

                        <% } %>

                    </tr>

                <% }) %>

            </tbody>

        </table>

        <!-- Bottom Button -->
        <div class="mt-3">

            <% if (currentUser && currentUser.role === 'admin') { %>

                <a href="/addCalories"
                   class="btn btn-success">
                    ➕ Add Preset Food
                </a>

            <% } else { %>

                <a href="/addCalories"
                   class="btn btn-success">
                    ➕ Add Custom Food
                </a>

            <% } %>

        </div>

    </div>

</div>

</body>
</html>
