<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Food Library</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<div class="container py-5">

    <div class="card shadow-lg">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h1 class="text-success mb-0">
                    🍎 Food Library
                </h1>

                <a href="/" class="btn btn-secondary">
                    ⬅ Back Home
                </a>

            </div>

            <!-- Search -->

            <form action="/calories" method="GET" class="row g-3 mb-4">

                <div class="col-md-8">

                    <input
                        type="text"
                        name="search"
                        class="form-control"
                        placeholder="Search food name or meal type..."
                        value="<%= search || '' %>">

                </div>

                <div class="col-md-2">

                    <button
                        type="submit"
                        class="btn btn-primary w-100">

                        🔍 Search

                    </button>

                </div>

                <div class="col-md-2">

                    <a href="/calories"
                       class="btn btn-outline-secondary w-100">

                        Clear

                    </a>

                </div>

            </form>

            <!-- Total Calories -->

            <div class="alert alert-info d-flex justify-content-between">

                <span>

                    <strong>Total Calories Displayed</strong>

                </span>

                <span>

                    🔥 <strong><%= totalCalories %></strong> kcal

                </span>

            </div>

            <!-- Food Table -->

            <table class="table table-hover table-bordered align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>Food</th>
                        <th>Calories</th>
                        <th>Meal Type</th>

                        <% if (currentUser.role === 'admin') { %>

                            <th width="220">
                                Actions
                            </th>

                        <% } else { %>

                            <th width="180">
                                Details
                            </th>

                        <% } %>

                    </tr>

                </thead>

                <tbody>

                <% if (calories.length > 0) { %>

                    <% calories.forEach(item => { %>

                    <tr>

                        <td>

                            <strong>
                                <%= item.foodName %>
                            </strong>

                        </td>

                        <td>

                            🔥 <%= item.calories %> kcal

                        </td>

                        <td>

                            <span class="badge bg-success">
                                <%= item.mealType %>
                            </span>

                        </td>

                        <% if (currentUser.role === 'admin') { %>

                        <td>

                            <a href="/editCalories/<%= item.id %>"
                               class="btn btn-warning btn-sm">

                                ✏ Edit

                            </a>

                            <a href="/deleteCalories/<%= item.id %>"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Delete this food?')">

                                🗑 Delete

                            </a>

                        </td>

                        <% } else { %>

                        <td>

                            <a href="/food/<%= item.id %>"
                               class="btn btn-success btn-sm">

                                🍽 Eat This

                            </a>

                        </td>

                        <% } %>

                    </tr>

                    <% }) %>

                <% } else { %>

                    <tr>

                        <td colspan="4"
                            class="text-center">

                            No food records found.

                        </td>

                    </tr>

                <% } %>

                </tbody>

            </table>

            <% if (currentUser.role === 'admin') { %>

            <div class="mt-4">

                <a href="/addCalories"
                   class="btn btn-success">

                    ➕ Add Food

                </a>

            </div>

            <% } %>

        </div>

    </div>

</div>

</body>

</html>
